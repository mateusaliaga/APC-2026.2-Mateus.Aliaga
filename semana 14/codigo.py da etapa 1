# 1c.
def descricao(dic, nome):
    pos = list(dic["Coluna"]).index(nome)
    linhas = [pos]
    j = pos + 1
    while j < len(dic) and pd.isna(dic["Coluna"].iloc[j]):
        linhas.append(j)
        j = j + 1
    return dic.iloc[linhas][["Descrição da coluna", "Valor", "Descrição do valor"]]


