def fatorial(n):
    resultado = 1
    for i in range(1, n + 1):
        resultado = resultado * i
    return resultado


print(fatorial(0))
print(fatorial(5))
print(fatorial(20))

# 0! = 1, 5! = 120 e 20! = 2432902008176640000.
#
# Num int de 32 bits em C o maior valor que cabe é 2147483647. 
#
# Python não tem esse limite, o inteiro cresce conforme precisa.
